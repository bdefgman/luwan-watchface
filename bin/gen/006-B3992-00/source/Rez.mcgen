    module Layouts {
        function WatchFace(dc as Graphics.Dc) as Array<WatchUi.Drawable> {
            var rez_cmp_local_custom_drawable_background = new BackgroundView({:identifier=>"background"});

            var rez_cmp_local_custom_drawable_aBarDisplay = new Complication({:identifier=>"aBarDisplay", :angle=>12, :text=>"BATT 90", :field_type=>1, :base=>270});

            var rez_cmp_local_custom_drawable_bBarDisplay = new Complication({:identifier=>"bBarDisplay", :angle=>10, :text=>"STEP 9K", :field_type=>2, :base=>210});

            var rez_cmp_local_custom_drawable_cBarDisplay = new Complication({:identifier=>"cBarDisplay", :angle=>2, :text=>"HR 72", :field_type=>9, :base=>330});

            var rez_cmp_local_custom_drawable_dBarDisplay = new Complication({:identifier=>"dBarDisplay", :angle=>4, :text=>"STEP 9K", :field_type=>3, :base=>30});

            var rez_cmp_local_custom_drawable_eBarDisplay = new Complication({:identifier=>"eBarDisplay", :angle=>6, :text=>"BATT 90", :field_type=>4, :base=>90});

            var rez_cmp_local_custom_drawable_fBarDisplay = new Complication({:identifier=>"fBarDisplay", :angle=>8, :text=>"HR 72", :field_type=>5, :base=>150});

            var rez_cmp_local_custom_drawable_bUBarDisplay = new BarDataComplication({:identifier=>"bUBarDisplay", :position=>1, :field_type=>6});

            var rez_cmp_local_custom_drawable_tUBarDisplay = new BarDataComplication({:identifier=>"tUBarDisplay", :position=>0, :field_type=>5});

            var rez_cmp_local_custom_drawable_bGraphDisplay = new GraphComplication({:identifier=>"bGraphDisplay", :position=>1});

            var rez_cmp_local_custom_drawable_tGraphDisplay = new GraphComplication({:identifier=>"tGraphDisplay", :position=>0});

            var rez_cmp_local_custom_drawable_digital = new MainDialHand({:identifier=>"digital"});

            var rez_cmp_local_custom_drawable_analog = new AnalogDial({:identifier=>"analog"});

            return [rez_cmp_local_custom_drawable_background, rez_cmp_local_custom_drawable_aBarDisplay, rez_cmp_local_custom_drawable_bBarDisplay, rez_cmp_local_custom_drawable_cBarDisplay, rez_cmp_local_custom_drawable_dBarDisplay, rez_cmp_local_custom_drawable_eBarDisplay, rez_cmp_local_custom_drawable_fBarDisplay, rez_cmp_local_custom_drawable_bUBarDisplay, rez_cmp_local_custom_drawable_tUBarDisplay, rez_cmp_local_custom_drawable_bGraphDisplay, rez_cmp_local_custom_drawable_tGraphDisplay, rez_cmp_local_custom_drawable_digital, rez_cmp_local_custom_drawable_analog] as Array<WatchUi.Drawable>;
        }
    } // Layouts

